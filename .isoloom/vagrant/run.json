{
  "$schema": "https://www.isoloom.com/schema/run-manifest/v0.json",
  "manifest_version": 0,
  "generator": {
    "name": "isoloom",
    "version": "1.0.2"
  },
  "environment": {
    "name": "bad-pods",
    "instance": null,
    "message": "A single-node Kubernetes cluster is up at 10.60.121.10. You are \"player\": you may\ncreate pods (and deployments, jobs, daemonsets...) and exec into them in the namespace badpods,\nnothing more. Use the bearer token in provision/tokens.csv against https://10.60.121.10:6443,\nor SSH in as player / player (kubectl is set up; Bad Pods' manifests are in ~/badPods).\nGoal: root on the node, then read /root/flag.txt.\n"
  },
  "target": "vagrant",
  "driver": "vagrant",
  "hosts": [
    "linux",
    "macos",
    "windows"
  ],
  "tools": [
    {
      "name": "vagrant",
      "probe": [
        "vagrant",
        "--version"
      ],
      "min_version": "2.4.0"
    },
    {
      "name": "virtualbox",
      "probe": [
        "VBoxManage",
        "--version"
      ],
      "providers": [
        "virtualbox"
      ]
    },
    {
      "name": "vmware",
      "probe": [
        "vmrun",
        "list"
      ],
      "providers": [
        "vmware_desktop"
      ]
    },
    {
      "name": "parallels",
      "probe": [
        "prlctl",
        "--version"
      ],
      "hosts": [
        "macos"
      ],
      "providers": [
        "parallels"
      ]
    },
    {
      "name": "libvirt",
      "probe": [
        "virsh",
        "--version"
      ],
      "hosts": [
        "linux"
      ],
      "providers": [
        "libvirt"
      ]
    },
    {
      "name": "qemu",
      "probe": [
        "qemu-img",
        "--version"
      ],
      "providers": [
        "qemu"
      ]
    }
  ],
  "identity": {
    "vagrant": {
      "providers": [
        {
          "id": "virtualbox",
          "hosts": [
            "linux",
            "macos",
            "windows"
          ],
          "elevation": "none",
          "refusal": null
        },
        {
          "id": "vmware_desktop",
          "hosts": [
            "linux",
            "macos",
            "windows"
          ],
          "plugin": "vagrant-vmware-desktop",
          "elevation": "none",
          "refusal": null
        },
        {
          "id": "hyperv",
          "hosts": [
            "windows"
          ],
          "elevation": "hyperv",
          "refusal": null
        },
        {
          "id": "parallels",
          "hosts": [
            "macos"
          ],
          "plugin": "vagrant-parallels",
          "elevation": "none",
          "refusal": null
        },
        {
          "id": "libvirt",
          "hosts": [
            "linux"
          ],
          "plugin": "vagrant-libvirt",
          "elevation": "none",
          "refusal": null
        },
        {
          "id": "qemu",
          "hosts": [
            "linux",
            "macos"
          ],
          "plugin": "vagrant-qemu",
          "elevation": "none",
          "refusal": null
        },
        {
          "id": "utm",
          "hosts": [
            "macos"
          ],
          "plugin": "vagrant_utm",
          "elevation": "none",
          "refusal": "`cluster` is on a network, and vagrant_utm gives a VM no private network (it only forwards ports)"
        },
        {
          "id": "vmware_esxi",
          "hosts": [
            "linux",
            "macos",
            "windows"
          ],
          "plugin": "vagrant-vmware-esxi",
          "elevation": "none",
          "remote": true,
          "refusal": null
        }
      ],
      "dotfile": "${run.state_dir}/vagrant"
    }
  },
  "params": [
    {
      "name": "ISOLOOM_HYPERV_SWITCH",
      "description": "The Hyper-V virtual switch each VM's first adapter (Vagrant's connection, and the internet) goes on.",
      "default": "Default Switch",
      "hosts": [
        "windows"
      ],
      "providers": [
        "hyperv"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ISOLOOM_HYPERV_SWITCH",
          "steps": [
            "*"
          ]
        }
      ]
    },
    {
      "name": "ISOLOOM_SSH_PROXY_COMMAND",
      "description": "The command Vagrant's SSH to the VMs goes through when this host can't reach them directly (an ESXi host through the runner's relay on macOS).",
      "providers": [
        "vmware_esxi"
      ],
      "set_by": "runner",
      "deliver": [
        {
          "via": "env",
          "var": "ISOLOOM_SSH_PROXY_COMMAND",
          "steps": [
            "*"
          ]
        }
      ]
    },
    {
      "name": "ESXI_HOSTNAME",
      "description": "The ESXi host.",
      "required": true,
      "providers": [
        "vmware_esxi"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ESXI_HOSTNAME",
          "steps": [
            "*"
          ]
        }
      ]
    },
    {
      "name": "ESXI_HOSTPORT",
      "description": "Its SSH port.",
      "default": "22",
      "providers": [
        "vmware_esxi"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ESXI_HOSTPORT",
          "steps": [
            "*"
          ]
        }
      ]
    },
    {
      "name": "ESXI_USERNAME",
      "description": "The ESXi user.",
      "default": "root",
      "providers": [
        "vmware_esxi"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ESXI_USERNAME",
          "steps": [
            "*"
          ]
        }
      ]
    },
    {
      "name": "ESXI_DATASTORE",
      "description": "The datastore the VMs' disks go on (default: ESXi's first).",
      "providers": [
        "vmware_esxi"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ESXI_DATASTORE",
          "steps": [
            "*"
          ]
        }
      ]
    },
    {
      "name": "ESXI_VIRTUAL_NETWORK",
      "description": "Port groups, comma-separated: the management network, then one per lab network.",
      "default": "VM Network",
      "providers": [
        "vmware_esxi"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ESXI_VIRTUAL_NETWORK",
          "steps": [
            "*"
          ]
        }
      ]
    },
    {
      "name": "ISOLOOM_DERIVED",
      "description": "0: the checks derived from the spec (reachability, no internet) are skipped.",
      "default": "1",
      "values": [
        "0",
        "1"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ISOLOOM_DERIVED",
          "steps": [
            "check-controller"
          ]
        }
      ]
    }
  ],
  "secrets": [
    {
      "name": "CTF_FLAG_MAIN",
      "kind": "input",
      "required": false,
      "sensitive": true,
      "machines": [
        "cluster"
      ],
      "default": "",
      "deliver": [
        {
          "via": "env",
          "var": "CTF_FLAG_MAIN",
          "steps": [
            "up",
            "provision",
            "provision-machine"
          ]
        }
      ]
    },
    {
      "name": "ESXI_PASSWORD",
      "kind": "connection",
      "required": true,
      "sensitive": true,
      "providers": [
        "vmware_esxi"
      ],
      "deliver": [
        {
          "via": "env",
          "var": "ESXI_PASSWORD",
          "steps": [
            "*"
          ]
        }
      ]
    }
  ],
  "networks": [
    {
      "name": "lab",
      "cidr": "10.60.121.0/24",
      "internet": true,
      "native": "isoloom-bad-pods-lab"
    }
  ],
  "machines": [
    {
      "name": "cluster",
      "role": "target",
      "os": "ubuntu-24.04",
      "arch": "amd64",
      "resources": {
        "cpus": 2,
        "memory_mb": 3072
      },
      "addresses": {
        "lab": "10.60.121.10"
      },
      "native": {
        "vagrant": "cluster",
        "vm_names": {
          "virtualbox": "bad-pods · cluster",
          "vmware_desktop": "bad-pods · cluster",
          "hyperv": "bad-pods-cluster",
          "parallels": "bad-pods · cluster",
          "libvirt": "bad-pods_cluster",
          "utm": "bad-pods · cluster",
          "vmware_esxi": "bad-pods-cluster"
        }
      },
      "ports": [
        {
          "name": "ssh",
          "port": 22,
          "protocol": "tcp",
          "http": false
        },
        {
          "name": "kubernetes-api",
          "port": 6443,
          "protocol": "tcp",
          "http": false
        }
      ]
    },
    {
      "name": "isoloom-controller",
      "role": "infra",
      "resources": {
        "cpus": 1,
        "memory_mb": 512
      },
      "addresses": {
        "lab": "10.60.121.253"
      },
      "native": {
        "vagrant": "isoloom-controller",
        "vm_names": {
          "virtualbox": "bad-pods · controller",
          "vmware_desktop": "bad-pods · controller",
          "hyperv": "bad-pods-controller",
          "parallels": "bad-pods · controller",
          "libvirt": "bad-pods_isoloom-controller",
          "utm": "bad-pods · controller",
          "vmware_esxi": "bad-pods-controller"
        }
      }
    }
  ],
  "lifecycle": {
    "up": [
      {
        "id": "reconcile",
        "note": "Clearing the state of a run on another provider, if any…",
        "action": "vagrant.reconcile_provider"
      },
      {
        "id": "discard-saved",
        "action": "vagrant.discard_aborted_saved",
        "failure": "tolerate",
        "providers": [
          "virtualbox"
        ]
      },
      {
        "id": "up",
        "note": "Building the lab's VMs (Windows machines take a while)…",
        "argv": [
          "vagrant",
          "up",
          "--provider",
          "${run.provider}"
        ],
        "timeout_s": 21600,
        "verdict": "fatal: \\[[^\\]]+\\]: (UNREACHABLE|FAILED)!.*"
      },
      {
        "id": "park-controller",
        "note": "Powering off the setup machine (it comes back for provisioning and checks)…",
        "action": "vagrant.park_controller",
        "timeout_s": 300,
        "failure": "tolerate",
        "providers": [
          "virtualbox",
          "vmware_desktop",
          "hyperv",
          "parallels",
          "libvirt",
          "utm",
          "vmware_esxi"
        ]
      }
    ],
    "down": [
      {
        "id": "destroy",
        "argv": [
          "vagrant",
          "destroy",
          "--force"
        ],
        "timeout_s": 1800,
        "when": "always"
      },
      {
        "id": "orphans",
        "action": "vagrant.remove_orphans",
        "when": "always",
        "failure": "tolerate",
        "providers": [
          "virtualbox",
          "parallels"
        ]
      },
      {
        "id": "reset",
        "action": "vagrant.reset_state"
      }
    ],
    "park": {
      "pause": [
        {
          "id": "suspend",
          "argv": [
            "vagrant",
            "suspend",
            "cluster"
          ],
          "timeout_s": 1800
        }
      ],
      "shutdown": [
        {
          "id": "halt",
          "argv": [
            "vagrant",
            "halt"
          ],
          "timeout_s": 1800
        }
      ]
    },
    "resume": [
      {
        "id": "discard-saved",
        "action": "vagrant.discard_aborted_saved",
        "failure": "tolerate",
        "providers": [
          "virtualbox"
        ]
      },
      {
        "id": "resume",
        "argv": [
          "vagrant",
          "up",
          "--no-provision",
          "--provider",
          "${run.provider}",
          "cluster"
        ],
        "timeout_s": 3600,
        "failure": "tolerate"
      },
      {
        "id": "discard-cut-off",
        "action": "vagrant.discard_aborted_saved",
        "failure": "tolerate",
        "providers": [
          "virtualbox"
        ]
      },
      {
        "id": "boot",
        "argv": [
          "vagrant",
          "up",
          "--no-provision",
          "--provider",
          "${run.provider}",
          "cluster"
        ],
        "timeout_s": 3600
      }
    ],
    "provision": {
      "all": [
        {
          "id": "provision",
          "argv": [
            "vagrant",
            "provision",
            "cluster"
          ],
          "timeout_s": 7200
        }
      ],
      "machine": [
        {
          "id": "provision-machine",
          "argv": [
            "vagrant",
            "provision",
            "${machine}"
          ],
          "timeout_s": 7200
        }
      ]
    },
    "status": {
      "id": "status",
      "argv": [
        "vagrant",
        "status",
        "--machine-readable"
      ],
      "timeout_s": 25,
      "provider_timeout_s": {
        "vmware_esxi": 120
      }
    }
  },
  "ready": [
    {
      "kind": "step_ok",
      "step": "up",
      "means": "every VM booted and ran its provisioners, the controller's playbooks included"
    },
    {
      "kind": "machines_running",
      "machines": [
        "cluster"
      ]
    }
  ],
  "outputs": [],
  "checks": {
    "protocol": "isoloom-check/1",
    "setup": [
      {
        "id": "wake-controller",
        "note": "Booting the setup machine for the checks…",
        "action": "vagrant.wake_controller",
        "timeout_s": 1800
      }
    ],
    "runners": [
      {
        "id": "isoloom-controller",
        "from": "from the environment's networks",
        "checks": [
          {
            "name": "the Kubernetes API answers",
            "kind": "http",
            "wait_s": 300,
            "derived": false
          },
          {
            "name": "checks/player.sh",
            "kind": "script",
            "wait_s": 0,
            "derived": false
          }
        ],
        "step": {
          "id": "check-controller",
          "argv": [
            "vagrant",
            "provision",
            "isoloom-controller",
            "--provision-with",
            "checks"
          ],
          "timeout_s": 390
        }
      }
    ],
    "teardown": [
      {
        "id": "park-controller",
        "note": "Powering off the setup machine (it comes back for provisioning and checks)…",
        "action": "vagrant.park_controller",
        "timeout_s": 300,
        "when": "always",
        "failure": "tolerate",
        "providers": [
          "virtualbox",
          "vmware_desktop",
          "hyperv",
          "parallels",
          "libvirt",
          "utm",
          "vmware_esxi"
        ]
      }
    ]
  },
  "recovery": {
    "stale_markers": [
      "verr_already_exists",
      "could not rename",
      "is locked",
      "different provider",
      "single provider at a time"
    ],
    "steps": [
      {
        "id": "destroy",
        "note": "Clearing what an earlier run left, then starting again…",
        "argv": [
          "vagrant",
          "destroy",
          "--force"
        ],
        "timeout_s": 180,
        "when": "always",
        "failure": "tolerate"
      },
      {
        "id": "orphans",
        "action": "vagrant.remove_orphans",
        "when": "always",
        "failure": "tolerate",
        "providers": [
          "virtualbox",
          "parallels"
        ]
      },
      {
        "id": "reset",
        "action": "vagrant.reset_state",
        "when": "always"
      }
    ],
    "retries": 1
  }
}
