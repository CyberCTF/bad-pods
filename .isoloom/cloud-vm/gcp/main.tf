# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  terraform -chdir=.isoloom/cloud-vm/gcp init && terraform -chdir=.isoloom/cloud-vm/gcp apply \
#           -var billing_account=<id> -var allowed_cidr=<your IP>/32 -var ssh_public_key="$(cat ~/.ssh/id_ed25519.pub)"
# Stop:   terraform -chdir=.isoloom/cloud-vm/gcp destroy (same variables)
# Then:   the machines wait for the project: run the lab through the Isothrum runner (run.json
#         beside this file), which delivers the project over SSH, waits for each set-up and runs the checks.

terraform {
  required_version = ">= 1.6"
  backend "local" {}
  required_providers {
    google = { source = "hashicorp/google", version = "~> 8.5.0" }
  }
}

variable "project" {
  type        = string
  default     = ""
  description = "An existing project; or leave empty and give billing_account for a project of its own"
}

variable "billing_account" {
  type        = string
  default     = ""
  description = "With no project: create one for this environment, billed here, deleted with it"
}

variable "org_id" {
  type    = string
  default = ""
}

variable "region" {
  type    = string
  default = "europe-west9"
}

variable "inputs" {
  type        = map(string)
  default     = {}
  sensitive   = true
  description = "Values given at launch"
}

variable "allowed_cidr" {
  type        = string
  description = "Who may reach the machines (SSH and the published ports), e.g. your IP/32"
}

variable "ssh_public_key" {
  type        = string
  description = "The key the machines let in: the Isothrum runner's (it delivers the project and runs the checks over SSH)"
}

variable "expires_at" {
  type        = string
  default     = ""
  description = "When the environment should end, in Unix seconds (empty: no end): a tag on every resource, so a reaper finds what to destroy, and the time the machines shut themselves down"
}

provider "google" {
  region = var.region
}

# A project of its own when none is given: everything goes when the environment is destroyed.
resource "google_project" "env" {
  count               = var.project == "" ? 1 : 0
  name                = "isoloom-bad-pods"
  project_id          = "isoloom-${terraform_data.id.output}"
  billing_account     = var.billing_account
  org_id              = var.org_id == "" ? null : var.org_id
  deletion_policy     = "DELETE"
  auto_create_network = false
}

resource "google_project_service" "compute" {
  count              = var.project == "" ? 1 : 0
  project            = google_project.env[0].project_id
  service            = "compute.googleapis.com"
  disable_on_destroy = false
}

resource "terraform_data" "id" {
  input = substr(replace(uuid(), "-", ""), 0, 8)
  lifecycle {
    ignore_changes = [input]
  }
}

locals {
  name    = "isoloom-bad-pods-${terraform_data.id.output}"
  project = var.project != "" ? var.project : google_project_service.compute[0].project
  zone    = "${var.region}-a"
}

# The environment's networks: a VPC network each, holding a subnetwork with its exact range.
resource "google_compute_network" "lab" {
  project                 = local.project
  name                    = "${local.name}-lab"
  auto_create_subnetworks = false
  mtu                     = 1500
}

resource "google_compute_subnetwork" "lab" {
  project       = local.project
  name          = "${local.name}-lab"
  network       = google_compute_network.lab.id
  ip_cidr_range = "10.60.121.0/24"
  region        = var.region
}

# Machine `cluster`: what may reach it.
resource "google_compute_firewall" "cluster_net_lab" {
  project       = local.project
  name          = "${local.name}-cluster-net-lab"
  network       = google_compute_network.lab.id
  direction     = "INGRESS"
  source_ranges = ["10.60.121.0/24"]
  target_tags   = ["${local.name}-cluster"]
  allow {
    protocol = "all"
  }
}

resource "google_compute_firewall" "cluster_ssh" {
  project       = local.project
  name          = "${local.name}-cluster-ssh"
  network       = google_compute_network.lab.id
  direction     = "INGRESS"
  source_ranges = [var.allowed_cidr]
  target_tags   = ["${local.name}-cluster"]
  allow {
    protocol = "tcp"
    ports    = ["22"]
  }
}

resource "google_compute_instance" "cluster" {
  project      = local.project
  name         = "${local.name}-cluster"
  machine_type = "e2-standard-2"
  zone         = local.zone
  tags         = ["${local.name}-cluster"]
  boot_disk {
    initialize_params {
      image = "ubuntu-os-cloud/ubuntu-2404-lts-amd64"
      size  = 30
    }
  }
  network_interface {
    subnetwork = google_compute_subnetwork.lab.id
    network_ip = "10.60.121.10"
    access_config {}
  }
  metadata                = { ssh-keys = "ubuntu:${var.ssh_public_key}" }
  metadata_startup_script = "#!/bin/sh\n# Isoloom: this machine sets itself up. Its progress is in /var/lib/isoloom/ready (isoloom-ready/1), its output in /var/log/isoloom-setup.log. The Isothrum runner delivers the project over SSH.\nmkdir -p /var/lib/isoloom\ncat > /var/lib/isoloom/setup.sh.new <<'ISOLOOM_SETUP'\n#!/bin/sh\numask 022\ncase \"$(head -n1 /var/lib/isoloom/ready 2>/dev/null)\" in ready|failed:*) exit 0 ;; esac\ne=${var.expires_at}; if [ -n \"$e\" ]; then m=$(( (e - $(date +%s)) / 60 )); [ \"$m\" -ge 1 ] || m=1; shutdown -h \"+$m\" >/dev/null 2>&1 || true; fi\npart=$(cat /var/lib/isoloom/part 2>/dev/null || echo 1)\nif [ \"$part\" = 1 ]; then\necho 'running: waiting for the project (the runner delivers it over SSH)' > /var/lib/isoloom/ready; { i=0; until [ -f /var/lib/isoloom/project-delivered ]; do i=$((i+5)); if [ $i -gt 2400 ]; then echo 'the project never came: start the lab through the Isothrum runner (run.json), which delivers it over SSH' >&2; exit 1; fi; sleep 5; done; } || { echo 'failed: waiting for the project (the runner delivers it over SSH)' > /var/lib/isoloom/ready; exit 1; }\necho 'running: growing the disk' > /var/lib/isoloom/ready; { sh -c 'set -e\npart_grow() {\n  dev=$(readlink -f \"$1\")\n  disk=/dev/$(lsblk -no PKNAME \"$dev\" | head -n1)\n  num=$(cat \"/sys/class/block/$(basename \"$dev\")/partition\")\n  if command -v growpart >/dev/null; then growpart \"$disk\" \"$num\" >/dev/null || true\n  else echo \", +\" | sfdisk --no-reread -N \"$num\" \"$disk\" >/dev/null 2>&1 && partx -u \"$disk\" || true; fi\n}\nfs_grow() { resize2fs \"$1\" >/dev/null 2>&1 || xfs_growfs / >/dev/null 2>&1 || true; }\nsrc=$(findmnt -n -o SOURCE /)\ncase \"$(lsblk -no TYPE \"$src\" | head -n1)\" in\n  lvm)\n    vg=$(lvs --noheadings -o vg_name \"$src\" | tr -d '\\'' '\\'')\n    for pv in $(pvs --noheadings -o pv_name -S vg_name=\"$vg\" | tr -d '\\'' '\\''); do part_grow \"$pv\"; pvresize \"$pv\" >/dev/null; done\n    lvextend -l +100%FREE \"$src\" >/dev/null 2>&1 || true\n    fs_grow \"$src\" ;;\n  part) part_grow \"$src\"; fs_grow \"$src\" ;;\nesac'; } || { echo 'failed: growing the disk' > /var/lib/isoloom/ready; exit 1; }\necho 'running: hosts file' > /var/lib/isoloom/ready; { sh -c 'printf '\\''%s\\n'\\'' '\\''10.60.121.10 cluster'\\'' | while IFS= read -r l; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done'; } || { echo 'failed: hosts file' > /var/lib/isoloom/ready; exit 1; }\necho 'running: waiting for its secrets' > /var/lib/isoloom/ready; { sh -c 'set -e\nn=0; until [ -f /var/lib/isoloom/secrets/.delivered ]; do [ \"$n\" -gt 0 ] || echo '\\''cluster: waiting for its secrets, which the runner (isothrum up) delivers'\\''; n=$((n+1)); if [ \"$n\" -gt 360 ]; then echo '\\''cluster: its secrets never came; start the environment with the runner (isothrum up), which reads them from their stores and delivers them'\\'' >&2; exit 1; fi; sleep 5; done\nmkdir -p /etc/isoloom\ncat > /etc/isoloom/apply-secrets.sh <<'\\''APPLY-SECRETS'\\''\n#!/bin/sh\n# The machine'\\''s secrets, put in place\ninstall -D -o 0 -g 0 -m 0400 /var/lib/isoloom/secrets/input-ctf-flag-main '\\''/run/lab/ctf_flag_main'\\''\nexit 0\nAPPLY-SECRETS\nchmod +x /etc/isoloom/apply-secrets.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-apply-secrets.service <<'\\''UNIT'\\''\n[Unit]\nDescription=The machine'\\''s secrets, put in place\nAfter=network-online.target\nWants=network-online.target\n\n[Service]\nType=oneshot\nRemainAfterExit=yes\nExecStart=-/etc/isoloom/apply-secrets.sh\n\n[Install]\nWantedBy=multi-user.target\nUNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-apply-secrets.service\nsystemctl restart isoloom-apply-secrets.service\nelse\nmkdir -p /etc/local.d && ln -sf /etc/isoloom/apply-secrets.sh /etc/local.d/isoloom-apply-secrets.start\nrc-update add local default >/dev/null 2>&1 || true\n/etc/isoloom/apply-secrets.sh || true\nfi'; } || { echo 'failed: waiting for its secrets' > /var/lib/isoloom/ready; exit 1; }\necho 'running: provision/k3s.sh' > /var/lib/isoloom/ready; { sh -c 'cd /opt/isoloom && sh -c '\\''sh provision/k3s.sh'\\'''; } || { echo 'failed: provision/k3s.sh' > /var/lib/isoloom/ready; exit 1; }\necho 'running: provision/cluster.sh' > /var/lib/isoloom/ready; { sh -c 'cd /opt/isoloom && sh -c '\\''sh provision/cluster.sh'\\'''; } || { echo 'failed: provision/cluster.sh' > /var/lib/isoloom/ready; exit 1; }\necho 'running: health check' > /var/lib/isoloom/ready; { sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'; } || { echo 'failed: health check' > /var/lib/isoloom/ready; exit 1; }\nfi\necho ready > /var/lib/isoloom/ready\nrm -f /var/lib/isoloom/part\ncommand -v systemctl >/dev/null && systemctl disable isoloom-setup.service >/dev/null 2>&1\nexit 0\nISOLOOM_SETUP\nmv -f /var/lib/isoloom/setup.sh.new /var/lib/isoloom/setup.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-setup.service <<'ISOLOOM_UNIT'\n[Unit]\nDescription=Isoloom: the machine's set-up\nWants=network-online.target\nAfter=network-online.target cloud-final.service google-startup-scripts.service\n\n[Service]\nType=oneshot\nExecStart=/bin/sh /var/lib/isoloom/setup.sh\nStandardOutput=append:/var/log/isoloom-setup.log\nStandardError=append:/var/log/isoloom-setup.log\nTimeoutStartSec=0\n\n[Install]\nWantedBy=multi-user.target\nISOLOOM_UNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-setup.service >/dev/null 2>&1\nsystemctl start --no-block isoloom-setup.service\nelse\nnohup sh /var/lib/isoloom/setup.sh >> /var/log/isoloom-setup.log 2>&1 &\nfi\n"
  labels = {
    isoloom-environment = "bad-pods"
    managed-by          = "isoloom"
    isoloom-instance    = local.name
    isoloom-expires-at  = var.expires_at
  }
}

output "machines" {
  value = { cluster = google_compute_instance.cluster.network_interface[0].access_config[0].nat_ip }
}

output "address_cluster" {
  value = google_compute_instance.cluster.network_interface[0].access_config[0].nat_ip
}

output "ssh_users" {
  value = { cluster = "ubuntu" }
}

output "ip" {
  value = google_compute_instance.cluster.network_interface[0].access_config[0].nat_ip
}

output "ready_file" {
  value = "/var/lib/isoloom/ready"
}
